      {
        "id": "faq_plano",
        "pergunta": "Vocês aceitam plano de saúde?",
        "resposta": "Esta página de demonstração não lista convênios. Na clínica real, a recepção informa quais planos são aceitos."
      },
      {
        "id": "faq_preco",
        "pergunta": "O preço do card inclui exame?",
        "resposta": "Não. O preço é só da consulta. Exame, se precisar, é combinado na própria consulta."
      },
      {
        "id": "faq_crm",
        "pergunta": "Os médicos têm CRM?",
        "resposta": "Sim. O número de cada médico é informado na consulta, não nesta página de demonstração."
      },
      {
        "id": "faq_urgencia",
        "pergunta": "É pronto-socorro?",
        "resposta": "Não. Atendemos com hora marcada. Urgência hospitalar deve ir ao serviço de emergência."
      },
      {
        "id": "faq_online",
        "pergunta": "Como funciona a teleconsulta?",
        "resposta": "Você marca o horário no site. O link da videochamada chega no WhatsApp antes do atendimento."
      },
      {
        "id": "faq_cancelar",
        "pergunta": "Como cancelo uma consulta?",
        "resposta": "Chame no WhatsApp com pelo menos 24 horas de antecedência e peça para liberar o horário."
      }
    ]
