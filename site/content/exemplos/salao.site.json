    "titulo": "Dúvidas",
    "itens": [
      {
        "id": "faq_agendar",
        "pergunta": "Preciso agendar?",
        "resposta": "Sim. Cada horário fica com uma profissional, para não formar espera na recepção."
      },
      {
        "id": "faq_preferencia",
        "pergunta": "Posso ir sem escolher a profissional?",
        "resposta": "Pode. Na agenda existe a opção sem preferência, e o salão encaixa você com quem estiver livre."
      },
      {
        "id": "faq_cor",
        "pergunta": "Coloração precisa de teste?",
        "resposta": "Sim. O teste de mecha faz parte do atendimento, antes de aplicar a cor no cabelo todo."
      },
      {
        "id": "faq_pagamento",
        "pergunta": "Quais formas de pagamento?",
        "resposta": "Dinheiro, PIX e cartão de débito ou crédito."
      },
      {
        "id": "faq_unhas",
        "pergunta": "Consigo fazer unha no mesmo dia do cabelo?",
        "resposta": "Sim, se a Lúcia tiver horário livre. Avise na observação ao agendar."
      },
      {
        "id": "faq_cancelar",
        "pergunta": "Como cancelo um horário?",
        "resposta": "Chame no WhatsApp com pelo menos 3 horas de antecedência e peça para liberar o horário."
      }
    ]
