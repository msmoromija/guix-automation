  "faq": {
    "titulo": "Dúvidas",
    "itens": [
      {
        "id": "faq_agendar",
        "pergunta": "O site marca a entrada do dia a dia?",
        "resposta": "Não. Aqui você marca avaliação e aula acompanhada. A entrada livre de quem já tem plano é na catraca da academia."
      },
      {
        "id": "faq_plano",
        "pergunta": "Quanto custa o plano mensal?",
        "resposta": "O valor do plano é passado depois da avaliação, no WhatsApp. Esta página mostra o preço das aulas avulsas."
      },
      {
        "id": "faq_horario",
        "pergunta": "Tem aula no meio do dia?",
        "resposta": "A grade acompanhada é de manhã cedo e no fim da tarde. Sábado é das 8h ao meio-dia."
      },
      {
        "id": "faq_inicio",
        "pergunta": "Nunca treinei. Por onde começo?",
        "resposta": "Pela avaliação ou pelo treino de iniciação. O professor explica os aparelhos nessa sessão."
      },
      {
        "id": "faq_pagamento",
        "pergunta": "Quais formas de pagamento?",
        "resposta": "Dinheiro, PIX e cartão de débito ou crédito."
      },
      {
        "id": "faq_cancelar",
        "pergunta": "Como cancelo um horário?",
        "resposta": "Chame no WhatsApp com pelo menos 3 horas de antecedência e peça para liberar a vaga."
      }
    ]
  },
