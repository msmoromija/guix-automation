    "itens": [
      {
        "id": "faq_agendar",
        "pergunta": "Preciso agendar?",
        "resposta": "Sim. O atendimento é com hora marcada, para não formar fila na porta."
      },
      {
        "id": "faq_preferencia",
        "pergunta": "Posso ir sem escolher o barbeiro?",
        "resposta": "Pode. Na agenda existe a opção sem preferência, e a casa encaixa você com quem estiver livre."
      },
      {
        "id": "faq_atraso",
        "pergunta": "E se eu atrasar?",
        "resposta": "Chegue no horário marcado. Com mais de 10 minutos de atraso, o horário pode passar para outra pessoa."
      },
      {
        "id": "faq_pagamento",
        "pergunta": "Quais formas de pagamento?",
        "resposta": "Dinheiro, PIX e cartão de débito ou crédito."
      },
      {
        "id": "faq_crianca",
        "pergunta": "Atendem criança?",
        "resposta": "Sim, no corte masculino. Avise a idade na observação do agendamento."
      },
      {
        "id": "faq_cancelar",
        "pergunta": "Como cancelo um horário?",
        "resposta": "Chame no WhatsApp com pelo menos 2 horas de antecedência e peça para liberar o horário."
      }
    ]
  },
