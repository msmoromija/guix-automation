# Chave em Integrações > Chaves de API. Não commitar o valor real.
ASAAS_API_KEY=

# Produção: https://api.asaas.com/v3
# Sandbox:  https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3

# Token de 32 a 255 caracteres, sem espaço. O mesmo valor entra no webhook do Asaas.
# O Asaas envia esse token no cabeçalho asaas-access-token.
ASAAS_WEBHOOK_TOKEN=

# URL pública do site.
NEXT_PUBLIC_SITE_URL=https://guix.net.br

# --- Mídia (R2 + Unsplash + OpenAI) — ver docs/imagens.md ---
# Cloudflare R2 (S3-compatible). Account ID no painel R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=guix-imagens
# URL pública do bucket (r2.dev Development URL ou custom domain).
# Ex.: https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
# Token Cloudflare compartilhado. E-mails: Zone Read + DNS Edit nas zonas dos clientes.
# Recursos R2 podem exigir também Workers R2 Storage Edit.
# O DNS é agnóstico: se o domínio estiver no Vercel DNS (nameservers vercel-dns.com),
# o módulo usa VERCEL_TOKEN + VERCEL_TEAM_ID e dispensa o Cloudflare.
CF_API_TOKEN=

# Unsplash — https://unsplash.com/oauth/applications (Access Key)
UNSPLASH_ACCESS_KEY=

# OpenAI — gpt-4o-mini para textos + sugestão de tags
OPENAI_API_KEY=

# Resend — e-mail automático (compras, agendamento, OTP)
RESEND_API_KEY=
# Ex.: GuiX.net <noreply@guix.net.br>
RESEND_FROM=
# Destinatários extras do rastreio de compra (além de msmoromija@gmail.com e atendimento@)
# Também é a lista de logins liberados no painel interno (ex.: /painel/emails). Separados por vírgula.
GUIX_OPS_EMAILS=msmoromija@gmail.com,atendimento@guix.net.br

# Opcional: segredo extra para hash do OTP (fallback: RESEND_API_KEY)
AGENDAR_OTP_SECRET=

# --- SMS OTP (telefone do cliente ao agendar) ---
# Twilio: https://console.twilio.com — Account SID, Auth Token e número From (E.164)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Alternativa ao Twilio: webhook genérico (Zenvia, Comtele, etc.)
# POST JSON { telefone, to, codigo, nome, negocioNome, mensagem }
AGENDAR_SMS_URL=
AGENDAR_SMS_TOKEN=

# Opcional: webhook WhatsApp (Z-API/Evolution) se SMS falhar
# POST JSON { telefone, codigo, nome, negocioNome, mensagem }
AGENDAR_WHATSAPP_OTP_URL=
AGENDAR_WHATSAPP_OTP_TOKEN=

# Token simples para APIs do painel (trocar por auth real depois).
PAINEL_MIDIA_TOKEN=

# HMAC das URLs privadas de clientes/{id}/… (fallback: PAINEL_MIDIA_TOKEN).
MIDIA_SIGNING_SECRET=

# Limite de upload em bytes (default 8388608 = 8 MB).
MIDIA_MAX_BYTES=8388608

# Rascunho por token (JSON no R2). Sem página hospedada. Default 72h.
PROTOTIPO_TTL_HORAS=72

# Após o cliente aprovar o protótipo: prazo GuiX para integração (horas).
GUIX_PRAZO_INTEGRACAO_HORAS=24
# E-mail que recebe a documentação do serviço aprovado (fallback: atendimento@)
GUIX_OPS_EMAIL=
# Token do painel /painel/aprovacoes (fallback: PAINEL_MIDIA_TOKEN)
GUIX_OPS_TOKEN=
# Webhook WhatsApp opcional para avisos de aprovação (fallback: AGENDAR_WHATSAPP_OTP_*)
GUIX_WHATSAPP_NOTIFY_URL=
GUIX_WHATSAPP_NOTIFY_TOKEN=

# --- DNA / runner pós-pago (GitHub + Vercel + DNS) ---
# Org onde nascem os repos site-<cliente>
GUIX_SITES_GIT_ORG=guix-sites
# Token GitHub com repo:create + contents:write (obrigatório para repo automático)
GUIX_SITES_GIT_TOKEN=
# Opcional: template owner/name para gerar o repo (ex.: guix-sites/template-casas-vite)
GUIX_SITES_TEMPLATE_REPO=
# 1 = tenta GitHub/Vercel no webhook (default). 0 = só grava R2 + checklist
GUIX_AUTO_PROVISION=1
# 1 = marca publicado + e-mail "site no ar" se o GitHub ok (mesmo sem Vercel sólido).
# Default (vazio): só publica automático com git OK + projeto Vercel ligado ao repo (não “sem git”).
GUIX_AUTO_PUBLICAR=
# Domínio padrão de teste (opcional). Em produção o domínio vem do pedido/ops.
GUIX_DOMINIO_CLIENTE=

# Vercel — cria projeto ligado ao repo GitHub
VERCEL_TOKEN=
# Obrigatório quando os domínios pertencem a um team (a API de DNS/domínios exige teamId).
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=
# Opcional: slug=https://api.vercel.com/v1/integrations/deploy/...
GUIX_VERCEL_DEPLOY_HOOKS=

# Cloudflare DNS (Zone Read + DNS Edit). E-mails descobrem a zona pelo domínio.
# Encaminhamento catch-all via Email Routing (se a API permitir)
GUIX_EMAIL_FORWARD_TO=atendimento@guix.net.br

# --- E-mails profissionais (módulo /painel/emails) ---
# Zoho Mail Admin API — OAuth 2.0 com refresh token (Self Client em https://api-console.zoho.com).
# Scopes: ZohoMail.organization.domains.ALL, ZohoMail.organization.accounts.ALL
# e ZohoMail.partner.organization.ALL (necessário para descobrir a organização sozinho).
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Opcional: ID da organização. Use quando o escopo de partner não estiver disponível.
ZOHO_ZOID=
# Região da conta (.com por padrão; use .eu / .in / .com.cn se a conta estiver noutra DC).
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MAIL_API_URL=https://mail.zoho.com/api
# Projeto na Vercel onde o domínio do cliente é anexado durante o provisionamento.
GUIX_VERCEL_PROJETO=

# Segredo usado para autenticar o Vercel Cron que retoma execuções pendentes.
CRON_SECRET=

# --- Prospecção de leads (/painel/prospeccao) ---
# Google Places API (New) — Text Search (Enterprise).
# Console: https://console.cloud.google.com/ (APIs e serviços > Biblioteca > Places API (New)).
# Habilite também o faturamento no projeto. A chave começa com "AIza".
# A chave também pode ser definida pelo painel; o valor do .env é o fallback.
GOOGLE_PLACES_API_KEY=
# Opcional: token extra para proteger a rota interna /api/painel/prospeccao/ia.
PROSPECCAO_IA_TOKEN=

# --- WhatsApp Business Platform (Cloud API oficial) — conexão da conta no painel ---
# App em https://developers.facebook.com/apps (tipo Business). Estes valores ficam
# só no servidor (nunca vão ao navegador).
# App ID e App Secret (Configurações do app > Básico).
META_APP_ID=
META_APP_SECRET=
# Configuration ID do Embedded Signup (WhatsApp > Configuração > Embedded Signup).
# Sem ele, o botão "Conectar com Facebook" fica desabilitado (resta a conexão manual).
META_CONFIG_ID=
# String secreta escolhida por você. Use a MESMA no painel do app em
# WhatsApp > Configuração > Webhook (Verify token).
META_VERIFY_TOKEN=
# Versão da Graph API (default v21.0).
META_GRAPH_VERSION=v21.0
# URL pública do webhook para cadastrar no app:
#   https://guix.net.br/api/webhooks/whatsapp
# Assine o campo "messages" (status: sent/delivered/read/failed).

# Supabase do hub (opcional; DNA já reserva as tabelas)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
