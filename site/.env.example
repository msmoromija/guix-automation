# Chave em Integrações > Chaves de API. Não commitar o valor real.
ASAAS_API_KEY=

# Produção: https://api.asaas.com/v3
# Sandbox:  https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3

# Token de 32 a 255 caracteres, sem espaço. O mesmo valor entra no webhook do Asaas.
# O Asaas envia esse token no cabeçalho asaas-access-token.
ASAAS_WEBHOOK_TOKEN=

# URL pública do site.
NEXT_PUBLIC_SITE_URL=https://guix.net.br

# --- Mídia (R2 + Unsplash + OpenAI) — ver docs/imagens.md ---
# Cloudflare R2 (S3-compatible). Account ID no painel R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=guix-imagens
# URL pública do bucket (r2.dev Development URL ou custom domain).
# Ex.: https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
# Opcional: Account API Token com Workers R2 Storage Edit (domínios R2 via API).
CF_API_TOKEN=

# Unsplash — https://unsplash.com/oauth/applications (Access Key)
UNSPLASH_ACCESS_KEY=

# OpenAI — gpt-4o-mini para textos + sugestão de tags
OPENAI_API_KEY=

# Resend — e-mail automático de agendamento/cancelamento para o negócio
# e código OTP do cliente ao agendar
RESEND_API_KEY=
# Ex.: GuiX.net <noreply@guix.net.br>
RESEND_FROM=

# Opcional: segredo extra para hash do OTP (fallback: RESEND_API_KEY)
AGENDAR_OTP_SECRET=

# --- SMS OTP (telefone do cliente ao agendar) ---
# Twilio: https://console.twilio.com — Account SID, Auth Token e número From (E.164)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Alternativa ao Twilio: webhook genérico (Zenvia, Comtele, etc.)
# POST JSON { telefone, to, codigo, nome, negocioNome, mensagem }
AGENDAR_SMS_URL=
AGENDAR_SMS_TOKEN=

# Opcional: webhook WhatsApp (Z-API/Evolution) se SMS falhar
# POST JSON { telefone, codigo, nome, negocioNome, mensagem }
AGENDAR_WHATSAPP_OTP_URL=
AGENDAR_WHATSAPP_OTP_TOKEN=

# Token simples para APIs do painel (trocar por auth real depois).
PAINEL_MIDIA_TOKEN=

# HMAC das URLs privadas de clientes/{id}/… (fallback: PAINEL_MIDIA_TOKEN).
MIDIA_SIGNING_SECRET=

# Limite de upload em bytes (default 8388608 = 8 MB).
MIDIA_MAX_BYTES=8388608

# Rascunho por token (JSON no R2). Sem página hospedada. Default 72h.
PROTOTIPO_TTL_HORAS=72

# Após o cliente aprovar o protótipo: prazo GuiX para integração (horas).
GUIX_PRAZO_INTEGRACAO_HORAS=24
# E-mail que recebe a documentação do serviço aprovado (fallback: atendimento@)
GUIX_OPS_EMAIL=
# Token do painel /painel/aprovacoes (fallback: PAINEL_MIDIA_TOKEN)
GUIX_OPS_TOKEN=
# Webhook WhatsApp opcional para avisos de aprovação (fallback: AGENDAR_WHATSAPP_OTP_*)
GUIX_WHATSAPP_NOTIFY_URL=
GUIX_WHATSAPP_NOTIFY_TOKEN=

# --- DNA sites-cliente (git + Supabase futuros) ---
# Org/grupo onde nascem os repos site-<cliente>
GUIX_SITES_GIT_ORG=guix-sites
# Token com permissão de criar repo (CI/runner — não usado no request HTTP ainda)
GUIX_SITES_GIT_TOKEN=
# Supabase do hub (opcional agora; DNA já reserva as tabelas)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
