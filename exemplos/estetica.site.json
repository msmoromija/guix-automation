  "faq": {
    "titulo": "Dúvidas",
    "itens": [
      {
        "id": "faq_agendar",
        "pergunta": "Preciso agendar?",
        "resposta": "Sim. A sala é reservada por horário, então não atendemos por ordem de chegada."
      },
      {
        "id": "faq_medico",
        "pergunta": "Vocês fazem procedimento médico?",
        "resposta": "Não. O estúdio faz estética: pele, massagem, sobrancelha e depilação. Não há consulta médica, botox nem preenchimento."
      },
      {
        "id": "faq_pele",
        "pergunta": "Posso fazer limpeza de pele se estiver com o rosto irritado?",
        "resposta": "Não. Se a pele estiver queimada de sol, ferida ou muito irritada, chame no WhatsApp antes e remarque."
      },
      {
        "id": "faq_pagamento",
        "pergunta": "Quais formas de pagamento?",
        "resposta": "Dinheiro, PIX e cartão de débito ou crédito."
      },
      {
        "id": "faq_atraso",
        "pergunta": "E se eu atrasar?",
        "resposta": "Chegue no horário. Com mais de 10 minutos de atraso, a sessão pode ser encurtada para não invadir o horário seguinte."
      },
      {
        "id": "faq_cancelar",
        "pergunta": "Como cancelo um horário?",
        "resposta": "Chame no WhatsApp com pelo menos 4 horas de antecedência e peça para liberar a sala."
      }
    ]
  },
