  "faq": {
    "titulo": "Dúvidas",
    "itens": [
      {
        "id": "faq_conversa",
        "pergunta": "A primeira conversa é paga?",
        "resposta": "Não. São 30 minutos, sem contrato. Os outros serviços têm o preço escrito no card."
      },
      {
        "id": "faq_mei",
        "pergunta": "Vocês cobram para abrir MEI?",
        "resposta": "A inscrição no portal do governo é gratuita. Os R$ 150 são da orientação do escritório, se você quiser esse horário."
      },
      {
        "id": "faq_nota",
        "pergunta": "Vocês emitem nota para quem não é cliente?",
        "resposta": "Não. O escritório não vende nota fiscal. Atendemos empresas com contrato ou pessoas na declaração."
      },
      {
        "id": "faq_documentos",
        "pergunta": "O que levo na reunião?",
        "resposta": "Documento com foto e o que tiver do assunto: informes, CNPJ ou guias. Se faltar papel, a reunião ainda serve para listar o que buscar."
      },
      {
        "id": "faq_sabado",
        "pergunta": "Atendem no sábado?",
        "resposta": "Não. A agenda é de segunda a sexta, das 8h às 17h."
      },
      {
        "id": "faq_cancelar",
        "pergunta": "Como cancelo uma reunião?",
        "resposta": "Chame no WhatsApp com pelo menos 4 horas de antecedência e peça para liberar o horário."
      }
    ]
  },
