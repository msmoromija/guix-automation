      },
      {
        "id": "faq_online",
        "pergunta": "Como funciona a sessão online?",
        "resposta": "Você marca o horário no site. O link da videochamada chega no WhatsApp antes do atendimento."
      },
      {
        "id": "faq_ado",
        "pergunta": "Adolescente precisa de responsável?",
        "resposta": "Sim. O responsável fica informado e assina o que o consultório pedir na primeira conversa."
