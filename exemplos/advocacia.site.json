  "faq": {
    "titulo": "Dúvidas",
    "itens": [
      {
        "id": "faq_resultado",
        "pergunta": "A consulta garante que eu ganho a causa?",
        "resposta": "Não. A consulta explica o cenário e o próximo passo. Resultado de processo não é prometido."
      },
      {
        "id": "faq_preco",
        "pergunta": "O preço do card inclui o processo?",
        "resposta": "Não. O preço é só da consulta. Peça, acordo ou ação, se existirem, são orçados depois."
      },
      {
        "id": "faq_documentos",
        "pergunta": "O que eu levo?",
        "resposta": "O que tiver: contrato, mensagens, nota ou protocolo. Se não tiver documento, a consulta ainda pode acontecer."
      },
      {
        "id": "faq_contrato",
        "pergunta": "Para analisar um contrato, quando envio o arquivo?",
        "resposta": "Com pelo menos um dia de antecedência, pelo WhatsApp, para a leitura caber no horário."
      },
      {
        "id": "faq_oab",
        "pergunta": "O escritório é inscrito na OAB?",
        "resposta": "Sim. O número de inscrição de cada advogado é informado na consulta, não nesta página de demonstração."
      },
      {
        "id": "faq_cancelar",
        "pergunta": "Como cancelo uma consulta?",
        "resposta": "Chame no WhatsApp com pelo menos 24 horas de antecedência e peça para liberar o horário."
      }
    ]
  },
